{
  "name": "latex-agent",
  "version": "1.0.6",
  "description": "Latex desktop AI workspace agent powered by Gemini",
  "main": "dist/main/main.js",
  "author": "Latex",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.main.json",
    "dist": "npm run build && electron-builder --win nsis",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.6.1",
    "@vitejs/plugin-react": "^4.3.1",
    "diff": "^5.2.0",
    "electron-store": "^10.0.0",
    "fast-glob": "^3.3.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.latex.agent",
    "productName": "Latex",
    "files": [
      "dist/**/*",
      "build/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Latex Setup 1.0.6.exe"
    }
  }
}
